            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/productos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "productos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Libro de Algebra\",\n  \"descripcion\": \"Texto usado en buen estado\",\n  \"precio\": 18.5,\n  \"categoria_id\": 1\n}"
        }
      }
    },
    {
      "name": "Marketplace - Crear orden",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/ordenes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ordenes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"producto_id\": 1,\n  \"comprador_id\": 2,\n  \"estado\": \"Pendiente\"\n}"
        }
      }
    },
    {
