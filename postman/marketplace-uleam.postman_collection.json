          "host": [
            "{{base_url}}"
          ],
          "path": [
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sender_id\": 1,\n  \"receiver_id\": 2,\n  \"content\": \"Hola, me interesa tu producto\"\n}"
        }
      }
    },
    {
      "name": "Comunidad - Listar misiones",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/missions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "missions"
          ]
        }
      }
    },
    {
      "name": "Admin - Crear categoria",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/categorias",
          "host": [
            "{{base_url}}"
          ],
